# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API. .env.local stays uncommitted.

# Project URL, for example https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable anon key. The dashboard reads with this key on the server.
# Do not put the service role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Unused in v1. Reserved for a later admin import.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
